{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent007.dev/schemas/pack-registry-v1.json",
  "title": "agent007 pack registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "packs"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "versions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "categories": { "type": "array", "items": { "type": "string" }, "default": [] },
          "tags": { "type": "array", "items": { "type": "string" }, "default": [] },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "min_agent007", "manifest_url", "manifest_sha256", "artifact_url", "artifact_sha256", "size_bytes", "published_at"],
              "properties": {
                "version": { "type": "string" },
                "min_agent007": { "type": "string" },
                "manifest_url": { "type": "string", "minLength": 1 },
                "manifest_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
                "artifact_url": { "type": "string", "minLength": 1 },
                "artifact_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
                "size_bytes": { "type": "integer", "minimum": 1 },
                "published_at": { "type": "string", "format": "date-time" },
                "yanked": { "type": "boolean", "default": false }
              }
            }
          }
        }
      }
    }
  }
}
